set -euo pipefail

read -rs -p "SimpleFIN Setup Token: " SETUP_TOKEN

CLAIM_URL="$(echo "$SETUP_TOKEN" | base64 --decode)"
printf "\nFetching URL...\n"
SIMPLEFIN_ACCESS_URL=$(curl -sS --fail -H 'Content-Length: 0' -X POST "$CLAIM_URL") \
  || { echo 'Fetching failed!' >&2; exit 1; }

printf "%s" "$SIMPLEFIN_ACCESS_URL" | secret-tool store --label="SimpleFIN Access URL" service simplefin account me
